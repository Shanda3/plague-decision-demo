{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plague-bureau",
  "main": "worker.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "DECISIONS_ENABLED": "false",
    "DECISIONS_PRICING_REVIEWED_UNTIL": "",
    "DECISIONS_DIAGNOSTICS": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plague-bureau-budget",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
